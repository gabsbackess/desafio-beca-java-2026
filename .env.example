# Banco de dados dos usuários
USER_DB_NAME=users_db
USER_DB_USER=seu_usuario
USER_DB_PASSWORD=sua_senha

# Banco de dados das transações
TRANSACTIONS_DB_NAME=transactions_db
TRANSACTIONS_DB_USER=seu_usuario
TRANSACTIONS_DB_PASSWORD=sua_senha

# API Mock (MockAPI.io): URL base do seu projeto, sem barra no final
MOCKAPI_URL=https://SEU_PROJETO.mockapi.io/api/v1

# Chave de comunicação entre o MS2 e o MS1 (GET /users/{id}). Use um texto longo e aleatório; nunca versione o valor real.
INTERNAL_API_KEY=troque_por_um_segredo_longo
